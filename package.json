{
  "name": "@eeacms/volto-eea-map",
  "version": "6.0.2",
  "description": "@eeacms/volto-eea-map: Volto add-on",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-eea-map",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-eea-map.git"
  },
  "addons": [
    "@eeacms/volto-embed",
    "@eeacms/volto-object-widget"
  ],
  "dependencies": {
    "@arcgis/core": "4.29.10",
    "@eeacms/volto-embed": "*",
    "@eeacms/volto-object-widget": "*",
    "@plone/scripts": "*",
    "esri-loader": "3.6.0",
    "events": "3.3.0",
    "jsoneditor": "10.1.0",
    "lodash": "4.17.21",
    "razzle-plugin-scss": "4.2.18",
    "react-color": "~2.19.3",
    "react-querybuilder": "6.5.5"
  },
  "devDependencies": {
    "@babel/preset-env": "7.24.6",
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "*",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "cypress-fail-fast": "^5.0.1",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "bootstrap": "npm install -g ejs; npm link ejs; node bootstrap",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "pre-commit": "pnpm stylelint:fix && pnpm prettier:fix && pnpm lint:fix",
    "stylelint": "make stylelint",
    "stylelint:overrides": "make stylelint-overrides",
    "stylelint:fix": "make stylelint-fix",
    "prettier": "make prettier",
    "prettier:fix": "make prettier-fix",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "i18n": "make i18n",
    "cypress:run": "make cypress-run",
    "cypress:open": "make cypress-open",
    "prepare": "husky install"
  }
}
